# AI Provider — "local" | "anthropic" | "openai" | "google"
AI_PROVIDER=local

# Local (Ollama) settings
OLLAMA_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# API keys — only needed if AI_PROVIDER is not "local"
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Database — SQLite locally, swap to a Postgres connection string for cloud later
DATABASE_URL="file:./dev.db"

# Session/auth secret — generate a real random value before any real use
SESSION_SECRET=change_me_in_production
